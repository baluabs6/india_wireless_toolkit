FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p charts reports

EXPOSE 8001

# Reads PORT from the environment (Azure Web App for Containers sets this
# automatically); defaults to 8001 otherwise.
CMD ["python", "-m", "india_wireless_toolkit.services.sanic_api.app"]
