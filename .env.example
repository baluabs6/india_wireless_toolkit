# Copy this file to .env and fill in real values.
# .env is gitignored — it will never be committed.
#
# These override the corresponding (blank) fields in config.yaml at
# runtime. See india_wireless_toolkit/config_loader.py for the mapping.

# Slack incoming webhook for news-scraper alerts
ALERT_WEBHOOK_URL=

# SMTP settings for email alerts (only used if news_scraper.alert_email.enabled: true)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDR=
SMTP_TO_ADDR=
SMTP_USER=
SMTP_PASSWORD=

# Required for the agentic AI assistant (india_wireless_toolkit/agent.py,
# `cli.py agent` and POST /agent/ask). Get a key from console.anthropic.com.
# Never commit this — .env is gitignored for exactly this reason.
ANTHROPIC_API_KEY=

# --- API protection (both web APIs) ---------------------------------------
# Callers must send this in the X-API-Key header on every route except /health.
# Comma-separate several keys to rotate without downtime ("new,old").
API_KEY=
# true = refuse every protected request when API_KEY is not configured (use in production).
API_REQUIRE_KEY=false
# true when running behind a proxy you control (Azure App Service, nginx) so rate limiting
# uses X-Forwarded-For instead of the proxy's address. Leave false when exposed directly.
TRUST_PROXY=false
