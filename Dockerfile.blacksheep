FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

# Run as an unprivileged user.
RUN useradd --system --uid 10001 --create-home app
COPY --chown=app:app . .
RUN mkdir -p charts reports var && chown -R app:app charts reports var
USER app

EXPOSE 8002

# /health is public (no API key needed). Reads PORT like the app does.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8002'), timeout=4).status == 200 else 1)"

# Reads PORT from the environment (Azure Web App for Containers sets this
# automatically); defaults to 8002 otherwise.
CMD ["python", "-m", "india_wireless_toolkit.services.blacksheep_api.app"]
